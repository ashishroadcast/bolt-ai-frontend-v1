# Dependencies
node_modules/

# Build output
dist/
dist-ssr/
# The embeddable `<bolt-ai-ask>` bundle (vite.element.config.ts). Build output
# like dist/, and deliberately not tracked here even though bolt-v2 vendors a
# copy at its own public/bolt-ai/ — one checked-in copy per consumer is a copy
# to forget to refresh.
dist-element/

# Firebase CLI deploy cache — a local hash of what was last uploaded. Machine
# specific, rewritten on every deploy, and says nothing a reader needs.
.firebase/

# Environment
.env
.env.local
.env.*.local

# Logs
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor
.vscode/*
!.vscode/extensions.json
.idea/

# OS
.DS_Store

# Test/coverage
coverage/
